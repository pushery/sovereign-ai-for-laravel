{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "pushery/sovereign-ai-for-laravel",
  "description": "IONOS AI Model Hub and OVHcloud AI Endpoints as providers for the Laravel AI SDK, held to endpoints in the EU, with a model catalog and token usage.",
  "keywords": [
    "laravel",
    "ai",
    "llm",
    "laravel-ai",
    "ionos",
    "ovhcloud",
    "eu",
    "sovereign-ai",
    "openai-compatible"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pushery"
    }
  ],
  "type": "library",
  "homepage": "https://github.com/pushery/sovereign-ai-for-laravel",
  "support": {
    "issues": "https://github.com/pushery/sovereign-ai-for-laravel/issues",
    "source": "https://github.com/pushery/sovereign-ai-for-laravel",
    "docs": "https://docs.pushery.com/sovereign-ai-for-laravel/",
    "security": "https://github.com/pushery/sovereign-ai-for-laravel/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "illuminate/contracts": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "laravel/ai": "^1.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9.3",
    "laravel/boost": "^2.9",
    "laravel/mcp": "^1.0",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^11.2",
    "pestphp/pest": "^5.2.1",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-evals": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpstan/phpstan": "2.3.5",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "pushery/sqlens-for-laravel": "^0.35",
    "rector/rector": "^2.7.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "symfony/yaml": "^7.4.17 || ^8.1.5"
  },
  "autoload": {
    "psr-4": {
      "Pushery\\SovereignAi\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pushery\\SovereignAi\\SovereignAiServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
